// BASE_THRESHOLD=3  - allow small differences in base case due to platform-specific atan2
// ROTATION_THRESHOLD=3

// Whole-pixel geometry, so every rotation covers the same pixels.
export component TestCase inherits Window {
    width: 64px;
    height: 32px;
    background: white;

    Rectangle {
        x: 0px;
        width: 32px;
        background: @conic-gradient(red 0deg, lime 120deg, blue 240deg, red 360deg);
    }

    Rectangle {
        x: 32px;
        width: 32px;
        background: @radial-gradient(circle, yellow 20%, blue);
    }
}
